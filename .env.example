# Codex / OpenAI Configuration
# Required if not using ChatGPT plan sign-in (Plus/Pro/Team/Edu/Enterprise)
OPENAI_API_KEY=sk-...

# Model configuration (gpt-5.3 recommended for best results)
OPENAI_MODEL=gpt-5.3
MODEL_REASONING_EFFORT=high

# Codex sandbox mode: read-only | workspace-write | danger-full-access
CODEX_SANDBOX=workspace-write

# Approval policy: never | on-request | on-failure | untrusted
CODEX_APPROVAL_POLICY=on-request

# Working directory for Codex (optional, defaults to current directory)
# CODEX_WORKING_DIR=/path/to/project
